 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", 
    RowBox[{"i", "<=", "6"}], ",", 
    RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"interpolating", " ", "functions"}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"PInterpolation", "=", 
      RowBox[{"Interpolation", "[", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"xValues", "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"M1", "->", "M"}], ",", 
             RowBox[{"\[Alpha]1", "->", "\[Alpha]"}], ",", 
             RowBox[{"Q", "->", "q"}]}], "}"}]}], ",", 
          RowBox[{"GRPower", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], "}"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"EInterpolation", "=", 
      RowBox[{"Interpolation", "[", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"xValues", "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"M1", "->", "M"}], ",", 
             RowBox[{"\[Alpha]1", "->", "\[Alpha]"}], ",", 
             RowBox[{"Q", "->", "q"}]}], "}"}]}], ",", 
          RowBox[{"SysEnergiesInLab", "[", "i", "]"}]}], "}"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dEdR", "=", 
      RowBox[{
       RowBox[{"Derivative", "[", "1", "]"}], "[", "EInterpolation", "]"}]}], 
     ";", "\n", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"solve", " ", "energy", " ", "conservation", " ", "equation"}], 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"diffEq", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"dEdR", "[", 
         RowBox[{"R", "[", "t", "]"}], "]"}], "*", 
        RowBox[{
         RowBox[{
          RowBox[{"R", "'"}], "[", "t", "]"}], "/", "yrpl"}]}], "==", 
       RowBox[{"-", 
        RowBox[{"PInterpolation", "[", 
         RowBox[{"R", "[", "t", "]"}], "]"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"R0", "=", 
      RowBox[{
       RowBox[{"xValues", "[", 
        RowBox[{"[", 
         RowBox[{"Num", "-", "2"}], "]"}], "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"M1", "->", "M"}], ",", 
         RowBox[{"\[Alpha]1", "->", "\[Alpha]"}], ",", 
         RowBox[{"Q", "->", "q"}]}], "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sol", "=", 
      RowBox[{"NDSolve", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"diffEq", ",", 
          RowBox[{
           RowBox[{"R", "[", "0", "]"}], "==", "R0"}], ",", 
          RowBox[{"WhenEvent", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"R", "[", "t", "]"}], "<=", 
              RowBox[{"xValues", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "/.", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"M1", "->", "M"}], ",", 
               RowBox[{"\[Alpha]1", "->", "\[Alpha]"}], ",", 
               RowBox[{"Q", "->", "q"}]}], "}"}]}], 
            ",", "\"\<StopIntegration\>\""}], "]"}]}], "}"}], ",", "R", ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0", ",", "Infinity"}], "}"}], ",", 
        RowBox[{"AccuracyGoal", "->", "10"}], ",", 
        RowBox[{"PrecisionGoal", "->", "15"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"RInterpolation", "=", 
      RowBox[{"R", "/.", " ", 
       RowBox[{"sol", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"FreqInterpolation", "=", 
      RowBox[{"Interpolation", "[", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
