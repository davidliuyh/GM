Cell[BoxData[{
 RowBox[{
  RowBox[{"GetEigensystem", "[", "]"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"draw", " ", "eigenvectors"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eigenvectorsData", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"eigenvectorInd", "=", "1"}], ",", 
     RowBox[{"eigenvectorInd", "<=", "6"}], ",", 
     RowBox[{"eigenvectorInd", "++"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"firstEigenvec", "=", 
       RowBox[{"eigenvectors", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "eigenvectorInd"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"correctedVecs", "=", 
       RowBox[{"FoldList", "[", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"prev", ",", "current"}], "}"}], ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Dot", "[", 
               RowBox[{"prev", ",", "current"}], "]"}], "<", "0"}], ",", 
             RowBox[{"-", "current"}], ",", "current"}], "]"}]}], "]"}], ",", 
         RowBox[{"First", "[", "firstEigenvec", "]"}], ",", 
         RowBox[{"Rest", "[", "firstEigenvec", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"threshold", "=", "0.5"}], ";", "\[IndentingNewLine]", 
      RowBox[{"smoothedComponents", "=", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"component", "=", 
           RowBox[{"correctedVecs", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "i"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{
                 RowBox[{"component", "[", 
                  RowBox[{"[", "j", "]"}], "]"}], "-", 
                 RowBox[{"component", "[", 
                  RowBox[{"[", 
                   RowBox[{"j", "-", "1"}], "]"}], "]"}]}], "]"}], ">", 
               "threshold"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"component", "[", 
                 RowBox[{"[", 
                  RowBox[{"j", ";;"}], "]"}], "]"}], "=", 
                RowBox[{"-", 
                 RowBox[{"component", "[", 
                  RowBox[{"[", 
                   RowBox[{"j", ";;"}], "]"}], "]"}]}]}], ";", 
               RowBox[{"Break", "[", "]"}]}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "2", ",", 
              RowBox[{"Length", "[", "component", "]"}]}], "}"}]}], "]"}], ";",
           "\[IndentingNewLine]", "component"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "6"}], "}"}]}], "\[IndentingNewLine]", 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"CurrentEigenvectorsData", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"directionInd", "=", "1"}], ",", 
        RowBox[{"directionInd", "<=", "6"}], ",", 
        RowBox[{"directionInd", "++"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"AppendTo", "[", 
          RowBox[{"CurrentEigenvectorsData", ",", 
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{"xValues", ",", 
              RowBox[{"smoothedComponents", "[", 
               RowBox[{"[", 
                RowBox[{"directionInd", ",", "All"}], "]"}], "]"}]}], "}"}], 
            "]"}]}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"eigenvectorsData", ",", "CurrentEigenvectorsData"}], "]"}], 
      ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
