           RowBox[{"1", "/", "5"}]]], "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"M1", "->", "M"}], ",", 
           RowBox[{"\[Alpha]1", "->", "\[Alpha]"}], ",", 
           RowBox[{"Q", "->", "q"}]}], "}"}]}], ",", 
        RowBox[{
