               RowBox[{"\[Alpha]1", "->", "\[Alpha]"}], ",", 
               RowBox[{"Q", "->", "q"}]}], "}"}]}], 
            ",", "\"\<StopIntegration\>\""}], "]"}]}], "}"}], ",", "R", ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0", ",", "Infinity"}], "}"}], ",", 
        RowBox[{"AccuracyGoal", "->", "10"}], ",", 
        RowBox[{"PrecisionGoal", "->", "15"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"RInterpolation", "=", 
      RowBox[{"R", "/.", " ", 
       RowBox[{"sol", "[", 
