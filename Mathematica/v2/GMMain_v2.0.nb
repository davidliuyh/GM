  RowBox[{"GetCloudEnergiesInLab", "[", "]"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SysEnergiesInLab", "[", "eigenvectorIndex_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\[Rho]1Values", ",", "\[Rho]2Values", ",", "Xsys", ",", "d1", ",", 
       "d2", ",", "CurrentEnergiesInLab"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Rho]1Values", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"M2", "/", 
          RowBox[{"(", 
           RowBox[{"M1", "+", "M2"}], ")"}]}], "*", "xValues"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"M1", "->", "M"}], ",", 
          RowBox[{"Q", "->", "q"}]}], "}"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"\[Rho]2Values", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"M1", "/", 
          RowBox[{"(", 
           RowBox[{"M1", "+", "M2"}], ")"}]}], "*", "xValues"}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"M1", "->", "M"}], ",", 
          RowBox[{"Q", "->", "q"}]}], "}"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Xsys", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Mc", "*", 
            RowBox[{"Xcs", "[", 
             RowBox[{"[", "eigenvectorIndex", "]"}], "]"}]}], "+", 
           RowBox[{"M1", "*", 
            RowBox[{"(", 
             RowBox[{"-", "\[Rho]1Values"}], ")"}]}], "+", 
           RowBox[{"M2", "*", "\[Rho]2Values"}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"Mc", "+", "M1", "+", "M2"}], ")"}]}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"M1", "->", "M"}], ",", 
          RowBox[{"Q", "->", "q"}]}], "}"}]}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"d1", "=", 
       RowBox[{
        RowBox[{
         FractionBox["M2", 
          RowBox[{"M1", "+", "M2"}]], "*", "xValues"}], "+", "Xsys"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{"CoM", " ", "to", " ", "BH1"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"d2", "=", 
       RowBox[{
        RowBox[{
         FractionBox["M1", 
          RowBox[{"M1", "+", "M2"}]], "*", "xValues"}], "-", "Xsys"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{"CoM", " ", "to", " ", "BH2"}], "*)"}], "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"CurrentEnergiesInLab", "=", 
