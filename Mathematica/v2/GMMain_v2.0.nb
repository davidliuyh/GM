      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"diffEq", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"dEdR", "[", 
         RowBox[{"R", "[", "t", "]"}], "]"}], "*", 
        RowBox[{
         RowBox[{
          RowBox[{"R", "'"}], "[", "t", "]"}], "/", "yrpl"}]}], "==", 
       RowBox[{"-", 
        RowBox[{"PInterpolation", "[", 
         RowBox[{"R", "[", "t", "]"}], "]"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"R0", "=", 
      RowBox[{
       RowBox[{"xValues", "[", 
