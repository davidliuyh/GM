Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"MassCompute", "[", 
   RowBox[{"Separation_", ",", "eigenvector_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"L", ",", "CloudField", ",", "MassIntegrand", ",", "TotalMass"}],
      "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"L", "=", 
      RowBox[{
       RowBox[{"2", "Separation"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Alpha]1", "->", "\[Alpha]"}], ",", 
         RowBox[{"M1", "->", "M"}]}], "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"CloudField", "=", 
      RowBox[{"HatStatesInCorotatingFrameNoDim", ".", "eigenvector"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"MassIntegrand", "=", 
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"CloudField", " ", "*", " ", 
          RowBox[{"Conjugate", "[", "CloudField", "]"}]}], ")"}], "/.", 
        RowBox[{"{", 
         RowBox[{"R", "->", "Separation"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"TotalMass", "=", 
      RowBox[{"NIntegrate", "[", 
       RowBox[{
        RowBox[{"MassIntegrand", "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Alpha]1", "->", "\[Alpha]"}], ",", 
           RowBox[{"M1", "->", "M"}], ",", 
           RowBox[{"Q", "->", "q"}]}], "}"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", 
          RowBox[{"-", "L"}], ",", "L"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"y", ",", 
          RowBox[{"-", "L"}], ",", "L"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"z", ",", 
          RowBox[{"-", "L"}], ",", "L"}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"PrecisionGoal", "->", "6"}], ",", "\[IndentingNewLine]", 
        RowBox[{"AccuracyGoal", "->", "20"}], ",", "\[IndentingNewLine]", 
        RowBox[{"MaxRecursion", "->", "40"}], ",", "\[IndentingNewLine]", 
        RowBox[{"Method", "->", 
         RowBox[{"{", "\"\<LocalAdaptive\>\"", "}"}]}]}], "]"}]}]}]}], 
   "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"MassCompute", "[", 
  RowBox[{
   RowBox[{"xValues", "[", 
    RowBox[{"[", "1", "]"}], "]"}], ",", 
   RowBox[{"eigenvectorsWithGrowthWidth", "[", 
    RowBox[{"[", 
     RowBox[{"100", ",", "1"}], "]"}], "]"}]}], "]"}]}], "Input",
