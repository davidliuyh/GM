Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"SysEnergiesInLab", "[", "eigenvectorIndex_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\[Rho]1Values", ",", "\[Rho]2Values", ",", "Xsys", ",", "d1", ",", 
       "d2", ",", "CurrentEnergiesInLab"}], "}"}], ",", 
     RowBox[{
      RowBox[{"\[Rho]1Values", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"M2", "/", 
          RowBox[{"(", 
           RowBox[{"M1", "+", "M2"}], ")"}]}], "*", "xValues"}], "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"M1", "->", "M"}], ",", 
          RowBox[{"Q", "->", "q"}]}], "}"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"\[Rho]2Values", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"M1", "/", 
          RowBox[{"(", 
           RowBox[{"M1", "+", "M2"}], ")"}]}], "*", "xValues"}], "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"M1", "->", "M"}], ",", 
          RowBox[{"Q", "->", "q"}]}], "}"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Xsys", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Mc", "*", 
            RowBox[{"Xcs", "[", 
             RowBox[{"[", "eigenvectorIndex", "]"}], "]"}]}], "+", 
           RowBox[{"M1", "*", 
            RowBox[{"(", 
             RowBox[{"-", "\[Rho]1Values"}], ")"}]}], "+", 
           RowBox[{"M2", "*", "\[Rho]2Values"}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{"Mc", "+", "M1", "+", "M2"}], ")"}]}], "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"M1", "->", "M"}], ",", 
          RowBox[{"Q", "->", "q"}]}], "}"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"d1", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"M2", "/", 
          RowBox[{"(", 
           RowBox[{"M1", "+", "M2"}], ")"}]}], "*", "xValues"}], "+", 
        "Xsys"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{"CoM", " ", "to", " ", "BH1"}], "*)"}], 
      RowBox[{"d2", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"M1", "/", 
          RowBox[{"(", 
           RowBox[{"M1", "+", "M2"}], ")"}]}], "*", "xValues"}], "-", 
        "Xsys"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{"CoM", " ", "to", " ", "BH2"}], "*)"}], 
      RowBox[{"CurrentEnergiesInLab", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Mc", "/", "\[Mu]"}], "*", 
          RowBox[{"CloudEnergiesInLab", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "eigenvectorIndex"}], "]"}], "]"}]}], "-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"M1", " ", "M2"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"xValues", " ", "Rb1"}], ")"}]}], "+", 
         RowBox[{
          RowBox[{"1", "/", "2"}], " ", "M1", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"\[Pi]", "^", "2"}], "*", 
            RowBox[{"GWFreqSquare", "[", 
             RowBox[{"[", "eigenvectorIndex", "]"}], "]"}]}], ")"}], " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"d1", " ", "Rb1"}], ")"}], "^", "2"}]}], "+", 
         RowBox[{
          RowBox[{"1", "/", "2"}], " ", "M2", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"\[Pi]", "^", "2"}], "*", 
            RowBox[{"GWFreqSquare", "[", 
             RowBox[{"[", "eigenvectorIndex", "]"}], "]"}]}], ")"}], " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"d2", " ", "Rb1"}], ")"}], "^", "2"}]}]}], "/.", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"M1", "->", "M"}], ",", 
          RowBox[{"\[Alpha]1", "->", "\[Alpha]"}], ",", 
          RowBox[{"Q", "->", "q"}]}], "}"}]}]}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
