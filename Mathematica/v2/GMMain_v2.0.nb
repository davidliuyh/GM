    RowBox[{"(*", 
     RowBox[{"interpolating", " ", "functions"}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"PInterpolation", "=", 
      RowBox[{"Interpolation", "[", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
