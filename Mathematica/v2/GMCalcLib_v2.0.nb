        "in", " ", "the", " ", "natrual", " ", 
       RowBox[{"unit", "."}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"GetGWFreqSq", "[", "eigenvectorIndex_", "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "DEDR", ",", "Xsys", ",", "d1", ",", "d2", ",", "d1Derivatives", ",",
           "d2Derivatives", ",", "RotationFreqSquare"}], "}"}], ",", 
        "\[IndentingNewLine]", 
