             RowBox[{"\[Alpha]1", "->", "\[Alpha]"}], ",", 
             RowBox[{"M1", "->", "M"}], ",", 
             RowBox[{"Q", "->", "q"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", "6"}], "}"}]}], "]"}], ",", 
