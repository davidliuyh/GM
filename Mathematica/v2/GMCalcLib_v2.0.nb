         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"d1", "=", 
          RowBox[{
           RowBox[{
            FractionBox["M2", 
             RowBox[{"M1", "+", "M2"}]], "*", "xValues"}], "+", "Xsys"}]}], ";",
