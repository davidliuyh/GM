Cell[BoxData[
 RowBox[{
  RowBox[{"GetEigensystem", "[", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"GetReducedHamiltonian", "[", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "find", " ", "eigensystem", " ", "of", " ", "the", " ", "reduced", " ", 
       "Hamiltonian"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"eigenvalues", ",", "eigenvectors"}], "}"}], "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Map", "[", 
        RowBox[{"Eigensystem", ",", 
         RowBox[{
          RowBox[{"DimlessReducedHamiltonian", "*", 
           RowBox[{"(", 
            RowBox[{"\[Mu]", " ", 
             SuperscriptBox["\[Alpha]1", "2"]}], ")"}]}], "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\[Alpha]1", "->", "\[Alpha]"}], ",", 
            RowBox[{"M1", "->", "M"}], ",", 
            RowBox[{"Q", "->", "q"}]}], "}"}]}]}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "calculate", " ", "derivatives", " ", "of", " ", "eigenvalues"}], 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"EigenvalueDerivatives", "=", 
      RowBox[{"NumericalDerivatives", "[", 
       RowBox[{"eigenvalues", ",", "xValues"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "DHD\[CapitalOmega]", " ", "of", " ", "each", " ", "eigenvector"}], 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"DHD\[CapitalOmega]OfEigenvector", "=", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"ConjugateTranspose", "[", 
            RowBox[{"eigenvectors", "[", 
             RowBox[{"[", 
              RowBox[{"k", ",", "j"}], "]"}], "]"}], "]"}], ".", 
           RowBox[{"DHD\[CapitalOmega]", "[", 
            RowBox[{"[", "k", "]"}], "]"}], ".", 
           RowBox[{"eigenvectors", "[", 
            RowBox[{"[", 
             RowBox[{"k", ",", "j"}], "]"}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", "6"}], "}"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"k", ",", "1", ",", 
          RowBox[{"Length", "[", "xValues", "]"}]}], "}"}]}], 
       "\[IndentingNewLine]", "]"}]}], ";"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
