            RowBox[{"\[Alpha]1", "->", "\[Alpha]"}], ",", 
            RowBox[{"Q", "->", "q"}]}], "}"}]}]}], "]"}]}], 
      "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
