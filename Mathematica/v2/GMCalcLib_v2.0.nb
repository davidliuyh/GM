Cell[BoxData[
 RowBox[{
  RowBox[{"ComputeAndSaveXc", "[", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"GetEigensystem", "[", "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Calculate", " ", "Xc"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"CloudCenterOfMass", "[", 
       RowBox[{"eigenvector_", 
        RowBox[{"(*", 
         RowBox[{
         "the", " ", "eigenvector", " ", "you", " ", "want", " ", "to", " ", 
          "calc"}], "*)"}], ",", "Separation_"}], "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "CloudField", ",", "MassIntegrand", ",", "TotalMass", ",", "L"}], 
         "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"L", "=", 
          RowBox[{
           RowBox[{"2", "Separation"}], "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[Alpha]1", "->", "\[Alpha]"}], ",", 
             RowBox[{"M1", "->", "M"}]}], "}"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"CloudField", "=", 
          RowBox[{"HatStatesInCorotatingFrameNoDim", ".", "eigenvector"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"MassIntegrand", "=", 
          RowBox[{"Simplify", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"CloudField", " ", "*", " ", 
              RowBox[{"Conjugate", "[", "CloudField", "]"}]}], ")"}], "/.", 
            RowBox[{"{", 
             RowBox[{"R", "->", "Separation"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"TotalMass", "=", 
          RowBox[{"NIntegrate", "[", 
           RowBox[{
            RowBox[{"MassIntegrand", "/.", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"\[Alpha]1", "->", "\[Alpha]"}], ",", 
               RowBox[{"M1", "->", "M"}], ",", 
               RowBox[{"Q", "->", "q"}]}], "}"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", 
              RowBox[{"-", "L"}], ",", "L"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"y", ",", 
              RowBox[{"-", "L"}], ",", "L"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"z", ",", 
              RowBox[{"-", "L"}], ",", "L"}], "}"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"PrecisionGoal", "->", "6"}], ",", "\[IndentingNewLine]", 
            RowBox[{"AccuracyGoal", "->", "20"}], ",", "\[IndentingNewLine]", 
            RowBox[{"MaxRecursion", "->", "40"}], ",", "\[IndentingNewLine]", 
            RowBox[{"Method", "->", 
             RowBox[{"{", "\"\<LocalAdaptive\>\"", "}"}]}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Re", "[", 
          RowBox[{
           RowBox[{"NIntegrate", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"x", "*", "MassIntegrand"}], "/.", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"\[Alpha]1", "->", "\[Alpha]"}], ",", 
                RowBox[{"M1", "->", "M"}], ",", 
                RowBox[{"Q", "->", "q"}]}], "}"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"x", ",", 
               RowBox[{"-", "L"}], ",", "L"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"y", ",", 
               RowBox[{"-", "L"}], ",", "L"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"z", ",", 
               RowBox[{"-", "L"}], ",", "L"}], "}"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"AccuracyGoal", "->", "10"}], ",", "\[IndentingNewLine]", 
             RowBox[{"MaxRecursion", "->", "40"}], ",", "\[IndentingNewLine]", 
             RowBox[{"Method", "->", 
              RowBox[{"{", "\"\<LocalAdaptive\>\"", "}"}]}]}], "]"}], "/", 
           "TotalMass"}], "]"}]}]}], 
       RowBox[{"(*", 
        RowBox[{"In", " ", "unit", " ", "of", " ", 
         RowBox[{"Rb1", "."}]}], "*)"}], "\[IndentingNewLine]", "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "<=", "6"}], ",", 
       RowBox[{"i", "++"}], ",", "\t", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"eigenvectorIndex", "=", "i"}], ";", 
        RowBox[{"(*", 
         RowBox[{
         "eigenvector", " ", "you", " ", "want", " ", "to", " ", "trace"}], 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"CurrentEigenvector", "=", 
         RowBox[{"eigenvectors", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "eigenvectorIndex", ",", "All"}], "]"}], 
          "]"}]}], ";", " ", "\[IndentingNewLine]", 
        RowBox[{"Xc", "=", 
         RowBox[{"ArrayFlatten", "[", 
          RowBox[{
           RowBox[{"Parallelize", "[", 
            RowBox[{"MapThread", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"CloudCenterOfMass", "[", 
                RowBox[{"#1", ",", "#2"}], "]"}], "&"}], ",", 
              RowBox[{"{", 
               RowBox[{"CurrentEigenvector", ",", "xValues"}], "}"}]}], "]"}],
             "]"}], ",", "1"}], "]"}]}], ";", " ", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"save", " ", "result"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"Save", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", 
             RowBox[{
             "FilePath", 
              ",", "\"\<DimlessCloudCenterOfMassOfEigenvector\>\""}], "}"}], 
            "]"}], "<>", 
           RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<From\>\"", "<>", 
           RowBox[{"ToString", "[", "xStart", "]"}], "<>", "\"\<To\>\"", "<>", 
           RowBox[{"ToString", "[", "xEnd", "]"}], "<>", "\"\<AtQ\>\"", "<>", 
           RowBox[{"ToString", "[", "q", "]"}], "<>", "\"\<.m\>\""}], ",", 
          RowBox[{"{", 
           RowBox[{"Xc", ",", "xValues", ",", "eigenvectorIndex", ",", "q"}], 
           "}"}]}], "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.967429089176445*^9, 3.967429092174738*^9}, {
   3.967429122563463*^9, 3.967429233036249*^9}, {3.9674293487771034`*^9, 
   3.967429349563549*^9}, {3.9674294689124546`*^9, 3.967429475275095*^9}, {
   3.9674297390061398`*^9, 3.9674297567158813`*^9}, 3.9674298917010536`*^9, {
   3.9674301906781044`*^9, 3.967430199807413*^9}, 3.9674323018607883`*^9, {
   3.9771460550425453`*^9, 3.9771460621912518`*^9}},
 Background->RGBColor[0.88, 1, 0.88],
 CellLabel->"In[12]:=",ExpressionUUID->"fc4d1def-339d-7a4c-9a40-d2718f7d2b44"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ComputeAndSaveQc", "[", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"GetEigensystem", "[", "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Calc", " ", "mass", " ", "quadrupole", " ", "Qc", " ", "in", " ", 
       "unit", " ", "of", " ", 
       SuperscriptBox["Rb1", "2"]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"MassQuadrupole", "[", 
       RowBox[{"eigenvector_", 
        RowBox[{"(*", 
         RowBox[{
         "the", " ", "eigenvector", " ", "you", " ", "want", " ", "to", " ", 
          "calc"}], "*)"}], ",", "Separation_"}], "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "CloudField", ",", "MassIntegrand", ",", "TotalMass", ",", "L", ",", 
          "MassQuadrupole", ",", "axis"}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"L", "=", 
          RowBox[{
           RowBox[{"2", "Separation"}], "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[Alpha]1", "->", "\[Alpha]"}], ",", 
             RowBox[{"M1", "->", "M"}]}], "}"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"CloudField", "=", 
          RowBox[{"HatStatesInCorotatingFrameNoDim", ".", "eigenvector"}]}], ";",
          " ", "\[IndentingNewLine]", 
         RowBox[{"MassIntegrand", "=", 
          RowBox[{"Simplify", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"CloudField", " ", "*", " ", 
              RowBox[{"Conjugate", "[", "CloudField", "]"}]}], ")"}], "/.", 
            RowBox[{"{", 
             RowBox[{"R", "->", "Separation"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"TotalMass", "=", 
          RowBox[{"NIntegrate", "[", 
           RowBox[{
            RowBox[{"MassIntegrand", "/.", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"\[Alpha]1", "->", "\[Alpha]"}], ",", 
               RowBox[{"M1", "->", "M"}], ",", 
               RowBox[{"Q", "->", "q"}]}], "}"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", 
              RowBox[{"-", "L"}], ",", "L"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"y", ",", 
              RowBox[{"-", "L"}], ",", "L"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"z", ",", 
              RowBox[{"-", "L"}], ",", "L"}], "}"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"PrecisionGoal", "->", "6"}], ",", "\[IndentingNewLine]", 
            RowBox[{"AccuracyGoal", "->", "20"}], ",", "\[IndentingNewLine]", 
            RowBox[{"MaxRecursion", "->", "40"}], ",", "\[IndentingNewLine]", 
            RowBox[{"Method", "->", 
             RowBox[{"{", "\"\<LocalAdaptive\>\"", "}"}]}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"axis", "=", 
          RowBox[{"{", 
           RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"MassQuadrupole", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"i", "<=", "j"}], ",", 
              RowBox[{
               RowBox[{"Re", "[", 
                RowBox[{
                 RowBox[{"NIntegrate", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"axis", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "*", 
                    RowBox[{"axis", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "*", "MassIntegrand"}], "/.", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\[Alpha]1", "->", "\[Alpha]"}], ",", 
                    RowBox[{"M1", "->", "M"}], ",", 
                    RowBox[{"Q", "->", "q"}]}], "}"}]}], ",", 
                   RowBox[{"{", 
                    RowBox[{"x", ",", 
                    RowBox[{"-", "L"}], ",", "L"}], "}"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"y", ",", 
                    RowBox[{"-", "L"}], ",", "L"}], "}"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"z", ",", 
                    RowBox[{"-", "L"}], ",", "L"}], "}"}], ",", 
                   "\[IndentingNewLine]", 
                   RowBox[{"AccuracyGoal", "->", "10"}], ",", 
                   "\[IndentingNewLine]", 
                   RowBox[{"MaxRecursion", "->", "40"}], ",", 
                   "\[IndentingNewLine]", 
                   RowBox[{"Method", "->", 
                    RowBox[{"{", "\"\<LocalAdaptive\>\"", "}"}]}]}], "]"}], "/",
                  "TotalMass"}], "]"}], "[", 
