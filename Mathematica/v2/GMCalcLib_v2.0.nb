             RowBox[{"M1", "->", "M"}], ",", 
             RowBox[{"\[Alpha]1", "->", "\[Alpha]"}], ",", 
             RowBox[{"Q", "->", "q"}]}], "}"}]}]}], ";", 
         RowBox[{"(*", 
