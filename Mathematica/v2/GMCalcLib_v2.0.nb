                    SuperscriptBox["xValues", "2"], "*", "Rb1"}], ")"}]}]}], "+", 
                RowBox[{"DEDR", "*", 
                 RowBox[{"Mc", "/", "\[Mu]"}]}]}], ")"}], "/", 
