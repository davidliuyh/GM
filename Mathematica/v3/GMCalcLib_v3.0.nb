Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   SubscriptBox["\[Omega]", "nlm"], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"LevelFrequncy", "[", 
      RowBox[{"n_", ",", "\[Alpha]_", ",", "\[Mu]_"}], "]"}], ":=", 
     RowBox[{"\[Mu]", 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        FractionBox[
         SuperscriptBox["\[Alpha]", "2"], 
         RowBox[{"2", 
          SuperscriptBox["n", "2"]}]]}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"growth", " ", "width"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"GrowthWidth", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"n_", ",", "l_", ",", "m_"}], "}"}], ",", "a_", ",", "M_", ",",
       "\[Alpha]_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"rplus", ",", "\[CapitalOmega]H", ",", "\[Mu]"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"rplus", "=", 
        RowBox[{"1", "+", 
         SqrtBox[
          RowBox[{"1", "-", 
           SuperscriptBox["a", "2"]}]]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"\[Mu]", "=", 
        RowBox[{"\[Alpha]", "/", "M"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"\[CapitalOmega]H", "=", 
        FractionBox["a", 
         RowBox[{"2", "M", " ", "rplus"}]]}], ";", 
       RowBox[{"(*", 
        RowBox[{
        "This", " ", "expression", " ", "is", " ", "wrong", " ", "in", " ", 
         "paper", " ", "Termination", " ", "of", " ", "Superradiance"}], 
        "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"2", "rplus", " ", 
        FractionBox[
         RowBox[{
          SuperscriptBox["2", 
           RowBox[{
            RowBox[{"4", "l"}], "+", "1"}]], 
          RowBox[{"Factorial", "[", 
           RowBox[{"n", "+", "l"}], "]"}]}], 
         RowBox[{
          SuperscriptBox["n", 
           RowBox[{
            RowBox[{"2", "l"}], "+", "4"}]], 
          RowBox[{"Factorial", "[", 
           RowBox[{"n", "-", "l", "-", "1"}], "]"}]}]], 
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox[
           RowBox[{"Factorial", "[", "l", "]"}], 
           RowBox[{
            RowBox[{"Factorial", "[", 
             RowBox[{"2", "l"}], "]"}], 
            RowBox[{"Factorial", "[", 
             RowBox[{
              RowBox[{"2", "l"}], "+", "1"}], "]"}]}]], ")"}], "2"], 
        RowBox[{"Product", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            SuperscriptBox["k", "2"], 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              SuperscriptBox["a", "2"]}], ")"}]}], "+", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              RowBox[{"a", " ", "m"}], "-", 
              RowBox[{"2", "rplus", " ", "M", " ", 
               RowBox[{"LevelFrequncy", "[", 
                RowBox[{"n", ",", "\[Alpha]", ",", "\[Mu]"}], "]"}]}]}], 
             ")"}], "2"]}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "1", ",", "l"}], "}"}]}], "]"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"m", " ", "\[CapitalOmega]H"}], "-", 
          RowBox[{"LevelFrequncy", "[", 
           RowBox[{"n", ",", "\[Alpha]", ",", "\[Mu]"}], "]"}]}], ")"}], 
        SuperscriptBox["\[Alpha]", 
         RowBox[{
          RowBox[{"4", "l"}], "+", "5"}]]}]}]}], "\[IndentingNewLine]", 
     "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.9821276669940376`*^9, 3.9821277153938866`*^9}},
 Background->RGBColor[1, 0.9, 0.8],
 CellLabel->"In[8]:=",ExpressionUUID->"4bb74fac-92d8-4e4c-a9f1-93e20571d839"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GetNonHermitionEigenSystem", 
   RowBox[{"(*", 
    RowBox[{"dimless", ",", " ", 
     RowBox[{"\[Mu]0", " ", 
      SuperscriptBox["\[Alpha]0", "2"], " ", "as", " ", "dim"}]}], "*)"}], "[", 
   RowBox[{"FilePath_", ",", "suffix_", ",", "\[Mu]0_", ",", "\[Alpha]0_"}], 
   "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[Alpha]", ",", "M", ",", "q", ",", "a1", ",", "a2", ",", 
      "DimlessReducedHamiltonian", ",", "DimlessDHD\[CapitalOmega]", ",", 
      "Dimless\[Omega]Lz", ",", "Params", ",", "ReducedHamiltonian", ",", 
      "ReducedHamiltonianWithGrowthWidth", ",", 
      "DimlessReducedHamiltonianWithGrowthWidth", ",", 
      "DimlessREigenvalueWithGrowthWidth", ",", "REigenvectorWithGrowthWidth",
       ",", "LEigenvectorWithGrowthWidth", ",", "outFile"}], "}"}], ",", 
    "\[IndentingNewLine]", 
