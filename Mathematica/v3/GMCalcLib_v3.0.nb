               "<>", "\"\<-\>\"", "<>", "suffix", "<>", "\"\<.m\>\""}]}], 
             "}"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"MXc", "=", 
          RowBox[{
           RowBox[{"Get", "[", 
            RowBox[{"FileNameJoin", "[", 
             RowBox[{"{", 
              RowBox[{"FilePath", ",", 
               RowBox[{"\"\<DimlessCloudCenterOfMassOfEigenvector\>\"", "<>", 
                RowBox[{"ToString", "[", "eigenvectorIndex", "]"}], 
                "<>", "\"\<-\>\"", "<>", "Msuffix", "<>", "\"\<.m\>\""}]}], 
              "}"}], "]"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"PXc", "=", 
          RowBox[{
           RowBox[{"Get", "[", 
            RowBox[{"FileNameJoin", "[", 
