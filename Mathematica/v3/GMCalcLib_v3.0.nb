                "<>", "\"\<-\>\"", "<>", "Psuffix", "<>", "\"\<.m\>\""}]}], 
              "}"}], "]"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"system", " ", "center", " ", "of", " ", "mass"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"Mc", "=", 
          RowBox[{
           RowBox[{"Params", "[", "\"\<qc\>\"", "]"}], "*", 
           RowBox[{"Params", "[", "\"\<M1\>\"", "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"M1", "=", 
          RowBox[{"Params", "[", "\"\<M1\>\"", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"M2", "=", 
          RowBox[{
           RowBox[{"Params", "[", "\"\<q\>\"", "]"}], "*", 
