                  RowBox[{"-", "1"}]}], "}"}], ",", "a2", ",", "M2", ",", 
                "\[Alpha]2"}], "]"}]}]}]}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"6", ",", "6"}], "}"}], "->", 
            RowBox[{
             RowBox[{"ReducedHamiltonian", "[", 
              RowBox[{"[", 
               RowBox[{"6", ",", "6"}], "]"}], "]"}], "+", 
             RowBox[{"\[ImaginaryI]", " ", 
              RowBox[{"GrowthWidth", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"2", ",", "1", ",", "1"}], "}"}], ",", "a2", ",", 
                "M2", ",", "\[Alpha]2"}], "]"}]}]}]}]}], 
          "\[IndentingNewLine]", "}"}]}], "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Alpha]1", "->", "\[Alpha]"}], ",", 
         RowBox[{"M1", "->", "M"}], ",", 
         RowBox[{"Q", "->", "q"}], ",", 
         RowBox[{"M2", "->", 
          RowBox[{"q", " ", "M"}]}], ",", 
         RowBox[{"\[Alpha]2", "->", 
          RowBox[{"q", " ", "\[Alpha]"}]}]}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"DimlessReducedHamiltonianWithGrowthWidth", "=", 
      RowBox[{"ReducedHamiltonianWithGrowthWidth", "/", 
       RowBox[{"(", 
        RowBox[{"\[Mu]0", " ", 
         SuperscriptBox["\[Alpha]0", "2"]}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "DimlessREigenvalueWithGrowthWidth", ",", 
        "REigenvectorWithGrowthWidth"}], "}"}], "=", 
      RowBox[{
      "Eigensystem", "[", "DimlessReducedHamiltonianWithGrowthWidth", "]"}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"LEigenvectorWithGrowthWidth", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"REigenvectorWithGrowthWidth", "[", 
           RowBox[{"[", "j", "]"}], "]"}], "\[Conjugate]"}], "/", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"REigenvectorWithGrowthWidth", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "\[Transpose]"}], ".", 
            RowBox[{"REigenvectorWithGrowthWidth", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], ")"}], "\[Conjugate]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", "6"}], "}"}]}], "]"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{"LEigenvectorWithGrowthWidth", " ", "is", " ", 
       TemplateBox[<|"boxes" -> FormBox[
           SubsuperscriptBox[
            OverscriptBox["\[Eta]", "^"], 
            StyleBox["i", "TI"], 
            RowBox[{
              StyleBox["L", "TI"], "\[Dagger]"}]], TraditionalForm], 
         "errors" -> {}, "input" -> "\\hat{\\eta}^{L\\dagger}_i", "state" -> 
         "Boxes"|>,
        "TeXAssistantTemplate"]}], "*)"}], "\[IndentingNewLine]", 
