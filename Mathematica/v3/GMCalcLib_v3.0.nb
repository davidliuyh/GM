         RowBox[{"(*", 
          RowBox[{"CoM", " ", "to", " ", "BH1"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"d2", "=", 
          RowBox[{
           RowBox[{
            FractionBox["M1", 
             RowBox[{"M1", "+", "M2"}]], "*", "R"}], "-", "Xsys"}]}], ";", 
         RowBox[{"(*", 
          RowBox[{"CoM", " ", "to", " ", "BH2"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"Dd1DR", "=", 
          RowBox[{
           FractionBox["M2", 
            RowBox[{"M1", "+", "M2"}]], "+", 
           RowBox[{
