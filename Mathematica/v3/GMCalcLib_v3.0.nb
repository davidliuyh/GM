             SuperscriptBox["\[Alpha]0", "2"]}], ")"}], "2"]}], ")"}], 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"d1", " ", "Rb1"}], ")"}], "2"]}], "+", 
       RowBox[{
