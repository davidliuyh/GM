     RowBox[{"outFile", "=", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"FilePath", ",", 
         RowBox[{"\"\<NonHermitionEigenSystem-\>\"", "<>", "suffix", 
          "<>", "\"\<.m\>\""}]}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"FileExistsQ", "[", "outFile", "]"}], ",", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Output file already exists at: \>\"", "<>", "outFile"}],
          "]"}], ";", 
        RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"Params", "[", "\"\<\[Alpha]1\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"M", "=", 
      RowBox[{
       RowBox[{"Params", "[", "\"\<M1\>\"", "]"}], "*", "Ms"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"q", "=", 
      RowBox[{"Params", "[", "\"\<q\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"a1", "=", 
      RowBox[{"Params", "[", "\"\<a1\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"a2", "=", 
      RowBox[{"Params", "[", "\"\<a2\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "DimlessReducedHamiltonian", ",", "DimlessDHD\[CapitalOmega]", ",", 
        "Dimless\[Omega]Lz", ",", "Params"}], "}"}], "=", 
      RowBox[{"Get", "[", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"FilePath", ",", 
          
          RowBox[{"\"\<DimlessReducedHamiltonian\>\"", "<>", "\"\<-\>\"", "<>",
            "suffix", "<>", "\"\<.m\>\""}]}], "}"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ReducedHamiltonian", "=", 
      RowBox[{"DimlessReducedHamiltonian", "*", 
       RowBox[{"(", 
        RowBox[{"\[Mu]0", " ", 
         SuperscriptBox["\[Alpha]0", "2"]}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ReducedHamiltonianWithGrowthWidth", "=", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ReplacePart", "[", 
        RowBox[{"ReducedHamiltonian", ",", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", "1"}], "}"}], "->", 
            RowBox[{
             RowBox[{"ReducedHamiltonian", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1"}], "]"}], "]"}], "+", 
             RowBox[{"\[ImaginaryI]", " ", 
              RowBox[{"GrowthWidth", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"2", ",", "0", ",", "0"}], "}"}], ",", "a1", ",", 
                "M1", ",", "\[Alpha]1"}], "]"}]}]}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"2", ",", "2"}], "}"}], "->", 
            RowBox[{
             RowBox[{"ReducedHamiltonian", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", "2"}], "]"}], "]"}], "+", 
             RowBox[{"\[ImaginaryI]", " ", 
              RowBox[{"GrowthWidth", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"2", ",", "1", ",", 
                  RowBox[{"-", "1"}]}], "}"}], ",", "a1", ",", "M1", ",", 
                "\[Alpha]1"}], "]"}]}]}]}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"3", ",", "3"}], "}"}], "->", 
            RowBox[{
             RowBox[{"ReducedHamiltonian", "[", 
              RowBox[{"[", 
               RowBox[{"3", ",", "3"}], "]"}], "]"}], "+", 
             RowBox[{"\[ImaginaryI]", " ", 
              RowBox[{"GrowthWidth", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"2", ",", "1", ",", "1"}], "}"}], ",", "a1", ",", 
                "M1", ",", "\[Alpha]1"}], "]"}]}]}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"4", ",", "4"}], "}"}], "->", 
