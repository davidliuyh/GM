           RowBox[{"(", 
            RowBox[{"Mc", "*", "PXc"}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"Mc", "+", "M1", "+", "M2"}], ")"}]}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"d1", "=", 
          RowBox[{
           RowBox[{
            FractionBox["M2", 
             RowBox[{"M1", "+", "M2"}]], "*", "R"}], "+", "Xsys"}]}], ";", 
