              RowBox[{"\"\<DimlessCloudCenterOfMassOfEigenvector\>\"", "<>", 
               RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<-\>\"", "<>", 
               "suffix", "<>", "\"\<.m\>\""}]}], "}"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"FileExistsQ", "[", "outFile", "]"}], ",", 
            RowBox[{
             RowBox[{"Print", "[", 
              
              RowBox[{"\"\<Skip eigenvector \>\"", ",", "i", 
               ",", "\"\<: file already exists -> \>\"", ",", "outFile"}], 
              "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"Continue", "[", "]"}], ";"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           
           RowBox[{"\"\<Calculating eigenvector \>\"", ",", "i", 
            ",", "\"\< of 6...\>\""}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"localXc", "=", 
           RowBox[{"CloudCenterOfMass", "[", 
            RowBox[{"i", ",", 
             RowBox[{"Params", "[", "\"\<R\>\"", "]"}]}], "]"}]}], ";", 
