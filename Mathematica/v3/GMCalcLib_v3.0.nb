         "\[IndentingNewLine]", 
         RowBox[{"Re", "[", 
          RowBox[{
           RowBox[{"NIntegrate", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"x", "*", "MassIntegrand"}], "/.", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"\[Alpha]1", "->", "\[Alpha]"}], ",", 
