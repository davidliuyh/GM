          RowBox[{"2", " ", "\[CapitalDelta]R"}], ")"}]}], "+", 
        RowBox[{
         FractionBox["3", "2"], 
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox["\[Alpha]1", "\[Alpha]0"], ")"}], "2"], 
         SqrtBox[
