      "\[IndentingNewLine]", 
      RowBox[{"q", " ", "=", " ", 
       RowBox[{"Params0", "[", "\"\<q\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"DimlessDHD\[CapitalOmega]", "=", 
       RowBox[{
        RowBox[{"Get", "[", 
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
