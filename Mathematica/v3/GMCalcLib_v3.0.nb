              SuperscriptBox["\[Alpha]0", "2"]}], ")"}], "2"]}], ")"}], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"d2", " ", "Rb1"}], ")"}], "2"]}], "]"}], ";"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"CurrentEnergiesInLab", "=", 
      RowBox[{
       RowBox[{
        FractionBox[
         RowBox[{"qc", "*", "M"}], "\[Mu]"], "*", 
        RowBox[{"GetDimlessCloudEnergyInLab", "[", 
         RowBox[{
         "FilePath", ",", "suffix", ",", "\[Mu]0", ",", "\[Alpha]0", ",", 
          "eigenvectorIndex"}], "]"}], "*", "\[Mu]0", "*", 
