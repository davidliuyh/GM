Cell[BoxData[
 RowBox[{
  RowBox[{"ComputeGRPower", 
   RowBox[{"(*", 
    RowBox[{"not", " ", "dimless"}], "*)"}], "[", 
   RowBox[{
   "FilePath_", ",", "suffix_", ",", "\[Mu]0_", ",", "\[Alpha]0_", ",", 
    "eigenvectorIndex_", ",", "DimlessGWFreqSquare_"}], 
   RowBox[{"(*", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"\[Mu]0", " ", 
        SuperscriptBox["\[Alpha]0", "2"]}], ")"}], "2"], " ", "as", " ", 
     "unit"}], "*)"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "Xc", ",", "Qc", ",", "Params", ",", "R", ",", "\[Alpha]", ",", "M", ",",
       "q", ",", "qc", ",", "\[Mu]", ",", "Rb1", ",", "Rb0", ",", 
      "CurrentQBBH", ",", "CurrentMassQuad", ",", "GRPower"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Xc", ",", "Params"}], "}"}], "=", 
      RowBox[{"Get", "[", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"FilePath", ",", 
          RowBox[{"\"\<DimlessCloudCenterOfMassOfEigenvector\>\"", "<>", 
           RowBox[{"ToString", "[", "eigenvectorIndex", "]"}], 
           "<>", "\"\<-\>\"", "<>", "suffix", "<>", "\"\<.m\>\""}]}], "}"}], 
        "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Qc", "=", 
      RowBox[{
       RowBox[{"Get", "[", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"FilePath", ",", 
           RowBox[{"\"\<DimlessQuadrupoleOfEigenvector\>\"", "<>", 
            RowBox[{"ToString", "[", "eigenvectorIndex", "]"}], 
            "<>", "\"\<-\>\"", "<>", "suffix", "<>", "\"\<.m\>\""}]}], "}"}], 
         "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"Params", "[", "\"\<\[Alpha]1\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"M", "=", 
      RowBox[{
       RowBox[{"Params", "[", "\"\<M1\>\"", "]"}], "*", "Ms"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"q", "=", 
      RowBox[{"Params", "[", "\"\<q\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"qc", "=", 
      RowBox[{"Params", "[", "\"\<qc\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"R", "=", 
      RowBox[{"Params", "[", "\"\<R\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Mu]", "=", 
      FractionBox["\[Alpha]", "M"]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Rb1", "=", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"\[Mu]", " ", "\[Alpha]"}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Rb0", "=", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"\[Mu]0", " ", "\[Alpha]0"}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Compute", " ", "GM", " ", "mass", " ", "quadrupoles", " ", "of", " ", 
       "the", " ", "eigenvectors"}], "*)"}], "\t", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"CurrentQBBH", "=", 
      RowBox[{
       RowBox[{"M", "*", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            FractionBox["q", 
             RowBox[{"1", "+", "q"}]], "*", "R", "*", "Rb0"}], "+", 
           FractionBox[
            RowBox[{"qc", "*", "Xc", "*", "Rb1"}], 
            RowBox[{"1", "+", "q", "+", "qc"}]]}], ")"}], "2"]}], "+", 
       RowBox[{"q", "*", "M", "*", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            FractionBox["1", 
             RowBox[{"1", "+", "q"}]], "*", "R", "*", "Rb0"}], "-", 
           FractionBox[
            RowBox[{"qc", "*", "Xc", "*", "Rb1"}], 
            RowBox[{"1", "+", "q", "+", "qc"}]]}], ")"}], "2"]}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"CurrentMassQuad", "=", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"qc", "*", "M", "*", "Qc", "*", 
         SuperscriptBox["Rb1", "2"]}], "+", 
        RowBox[{"SparseArray", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", "1"}], "}"}], "->", "CurrentQBBH"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"3", ",", "3"}], "}"}]}], "]"}]}], ")"}]}], ";", " ", 
     RowBox[{"(*", "dimensional", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"CurrentMassQuad", ",", 
       RowBox[{"qc", "*", "M", "*", "Qc", "*", 
        SuperscriptBox["Rb1", "2"]}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<freq:\>\"", ",", "DimlessGWFreqSquare"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GRPower", "=", 
      RowBox[{
       FractionBox["2", "5"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"16", " ", 
