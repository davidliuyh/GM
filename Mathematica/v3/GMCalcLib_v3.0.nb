Cell[BoxData[
 RowBox[{
  RowBox[{"GetEmissionRatio", "[", 
   RowBox[{"FilePath_", ",", "suffix_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "Eigens", ",", "RV", ",", "LV", ",", "Params", ",", 
      "DimlessH\[CapitalGamma]", ",", "EmissionRates", ",", "Rvector", ",", 
      "totalEmission", ",", "BH1Emission", ",", "ratios"}], "}"}], ",", 
    RowBox[{
    "(*", "\:52a0\:8f7d\:975e\:5384\:7c73\:672c\:5f81\:7cfb\:7edf", "*)"}], 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "Eigens", ",", "RV", ",", "LV", ",", "DimlessH\[CapitalGamma]", ",", 
        "Params"}], "}"}], "=", 
      RowBox[{"Get", "[", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"FilePath", ",", 
          
          RowBox[{"\"\<NonHermitionEigenSystem-\>\"", "<>", "suffix", 
           "<>", "\"\<.m\>\""}]}], "}"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"\:63d0\:53d6\:5bf9\:89d2\:865a\:90e8", 
        RowBox[{"\:ff08", "\:53d1\:5c04\:7387", "\:ff09"}]}], ",", 
       RowBox[{"\:82e5\:4e3a\:8d1f\:5219\:8868\:793a\:5438\:6536", 
        RowBox[{"\:ff08", 
         RowBox[{"diag", " ", "term\:662f\:589e\:957f\:7387"}], 
         "\:ff09"}]}]}], "*)"}], 
     RowBox[{"EmissionRates", "=", 
      RowBox[{"2", " ", 
       RowBox[{"Im", "[", 
        RowBox[{"Diagonal", "[", "DimlessH\[CapitalGamma]", "]"}], "]"}]}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{
     "(*", "\:8ba1\:7b97\:6bcf\:4e2a\:672c\:5f81\:6001\:7684\:5438\:6536\:6bd4\
\:4f8b", "*)"}], 
     RowBox[{"ratios", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Rvector", "=", 
          RowBox[{"RV", "[", 
           RowBox[{"[", "j", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"BH1", " ", "\:53d1\:5c04", 
           RowBox[{"\:ff08", "\:524d3\:7ef4", "\:ff09"}]}], "*)"}], 
         RowBox[{"BH1Emission", "=", 
          RowBox[{"Total", "[", 
           RowBox[{
            RowBox[{"EmissionRates", "[", 
             RowBox[{"[", 
              RowBox[{"1", ";;", "3"}], "]"}], "]"}], "*", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"Rvector", "[", 
               RowBox[{"[", 
                RowBox[{"1", ";;", "3"}], "]"}], "]"}], "]"}], "^", "2"}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"\:603b\:53d1\:5c04", 
           RowBox[{"\:ff08", "\:6240\:67096\:7ef4", "\:ff09"}]}], "*)"}], 
         RowBox[{"totalEmission", "=", 
          RowBox[{"Total", "[", 
           RowBox[{"EmissionRates", "*", 
            RowBox[{
             RowBox[{"Abs", "[", "Rvector", "]"}], "^", "2"}]}], "]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"(*", "\:6bd4\:4f8b", "*)"}], 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"totalEmission", "==", "0"}], ",", "0", ",", 
           RowBox[{"BH1Emission", "/", "totalEmission"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "1", ",", "6"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"\:8fd4\:56de", "\:ff1a", 
       RowBox[{"{", 
        RowBox[{
        "EmissionRates", "\:ff0c", "BH1\:53d1\:5c04\:6bd4\:4f8b", "\:ff0c", 
         "BH2\:53d1\:5c04\:6bd4\:4f8b"}], "}"}]}], "*)"}], 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"EmissionRates", ",", "ratios", ",", 
        RowBox[{"1", "-", "ratios"}]}], "}"}], "]"}]}]}], "]"}]}]], "Input",
