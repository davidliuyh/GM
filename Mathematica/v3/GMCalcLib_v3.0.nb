Cell[BoxData[
 RowBox[{
  RowBox[{"ComputeAndSaveQc", 
   RowBox[{"(*", 
    RowBox[{"dimless", ",", " ", "Rb1"}], "*)"}], "[", 
   RowBox[{"FilePath_", ",", "suffix_", ",", "\[Alpha]0_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "DimlessREigenvalueWithGrowthWidth", ",", "REigenvectorWithGrowthWidth", 
      ",", "LEigenvectorWithGrowthWidth", ",", 
      "DimlessReducedHamiltonianWithGrowthWidth", ",", "Params", ",", 
      "\[Alpha]", ",", "M", ",", "q", ",", "\[Mu]", ",", "Rb1", ",", 
      "HatStatesInCorotatingFrameNoDim", ",", "MassQuadrupole"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"outFile", "=", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"FilePath", ",", 
         RowBox[{"\"\<DimlessQuadrupoleOfEigenvector\>\"", "<>", 
          RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<-\>\"", "<>", 
          "suffix", "<>", "\"\<.m\>\""}]}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"FileExistsQ", "[", "outFile", "]"}], ",", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Integrands file already exists at: \>\"", "<>", 
          "outFile"}], "]"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Load", " ", "non"}], "-", 
       RowBox[{"Hermitian", " ", "eigen", " ", "system"}]}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "DimlessREigenvalueWithGrowthWidth", ",", 
        "REigenvectorWithGrowthWidth", ",", "LEigenvectorWithGrowthWidth", ",",
         "DimlessReducedHamiltonianWithGrowthWidth", ",", "Params"}], "}"}], "=", 
      RowBox[{"Get", "[", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"FilePath", ",", 
          
          RowBox[{"\"\<NonHermitionEigenSystem\>\"", "<>", "\"\<-\>\"", "<>", 
           "suffix", "<>", "\"\<.m\>\""}]}], "}"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"HatStatesInCorotatingFrameNoDim", "=", 
      RowBox[{"Get", "[", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{
         "FilePath", ",", "\"\<HatStatesInCorotatingFrameNoDim.m\>\""}], 
         "}"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"Params", "[", "\"\<\[Alpha]1\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"M", "=", 
      RowBox[{
       RowBox[{"Params", "[", "\"\<M1\>\"", "]"}], "*", "Ms"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"q", "=", 
      RowBox[{"Params", "[", "\"\<q\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Mu]", "=", 
      FractionBox["\[Alpha]1", "M1"]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Rb1", "=", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"\[Mu]", " ", "\[Alpha]1"}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
       "Define", " ", "function", " ", "to", " ", "compute", " ", "mass", " ",
         "quadrupole", " ", "for", " ", "a", " ", "single", " ", 
        "eigenvector"}], ",", 
       RowBox[{"using", " ", "biorthogonal", " ", "basis"}]}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"MassQuadrupole", "[", 
       RowBox[{"eigenvectorIndex_Integer", ",", "Separation_"}], 
       RowBox[{"(*", 
        RowBox[{"in", " ", "unit", " ", "Rb0"}], "*)"}], "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "CloudField", ",", "L", ",", "MassIntegrand", ",", "TotalMass", ",", 
          "Rvector", ",", "Lvector", ",", "axis", ",", "Qc"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"L", "=", 
          RowBox[{"2", " ", "Separation"}]}], ";", 
         RowBox[{"(*", 
          RowBox[{"integration", " ", "range"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "Get", " ", "right", " ", "and", " ", "left", " ", "vectors"}], 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{"Rvector", "=", 
          RowBox[{"REigenvectorWithGrowthWidth", "[", 
           RowBox[{"[", "eigenvectorIndex", "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Lvector", "=", 
          RowBox[{"LEigenvectorWithGrowthWidth", "[", 
           RowBox[{"[", "eigenvectorIndex", "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Construct", " ", "density", " ", 
            RowBox[{"matrix", ":", " ", 
             RowBox[{"|", 
              RowBox[{"R", ">", "<", "L"}], "|"}]}]}], ",", 
           RowBox[{
            RowBox[{"since", " ", "Tr", 
             RowBox[{"(", 
              RowBox[{"|", 
               RowBox[{"R", ">", "<", "L"}], "|"}], ")"}]}], "=", "1"}]}], 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{"CloudField", "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"HatStatesInCorotatingFrameNoDim", ".", "Rvector"}], 
            ")"}], "*", 
           RowBox[{"Conjugate", "[", 
            RowBox[{"HatStatesInCorotatingFrameNoDim", ".", "Lvector"}], 
            "]"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"Mass", " ", "density", " ", "distribution"}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"MassIntegrand", "=", 
          RowBox[{"Simplify", "[", 
           RowBox[{"CloudField", "/.", " ", 
            RowBox[{"{", 
             RowBox[{"R", "->", 
              RowBox[{
               RowBox[{"Separation", "/", "\[Alpha]0"}], "*", "\[Alpha]1"}]}],
              "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"Calculate", " ", "total", " ", "mass", " ", 
           RowBox[{"(", 
            RowBox[{"normalization", " ", "factor"}], ")"}]}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"TotalMass", "=", 
          RowBox[{"NIntegrate", "[", 
           RowBox[{
            RowBox[{"MassIntegrand", "/.", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"\[Alpha]1", "->", "\[Alpha]"}], ",", 
               RowBox[{"M1", "->", "M"}], ",", 
               RowBox[{"Q", "->", "q"}]}], "}"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", 
              RowBox[{"-", "L"}], ",", "L"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"y", ",", 
              RowBox[{"-", "L"}], ",", "L"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"z", ",", 
              RowBox[{"-", "L"}], ",", "L"}], "}"}], ",", 
            RowBox[{"PrecisionGoal", "->", "6"}], ",", 
            RowBox[{"AccuracyGoal", "->", "20"}], ",", 
            RowBox[{"MaxRecursion", "->", "40"}], ",", 
            RowBox[{"Method", "->", 
             RowBox[{"{", "\"\<LocalAdaptive\>\"", "}"}]}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"axis", "=", 
          RowBox[{"{", 
           RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"Calculate", " ", "quadrupole", " ", "moments", " ", 
           RowBox[{"(", 
            RowBox[{"unit", ":", 
             RowBox[{"Rb1", "^", "2"}]}], ")"}]}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"Qc", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"i", "<=", "j"}], ",", 
              RowBox[{"Re", "[", 
               RowBox[{
                RowBox[{"NIntegrate", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"axis", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "*", 
                    RowBox[{"axis", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "*", "MassIntegrand"}], "/.",
                    " ", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\[Alpha]1", "->", "\[Alpha]"}], ",", 
                    RowBox[{"M1", "->", "M"}], ",", 
                    RowBox[{"Q", "->", "q"}]}], "}"}]}], ",", 
                  RowBox[{"{", 
                   RowBox[{"x", ",", 
                    RowBox[{"-", "L"}], ",", "L"}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"y", ",", 
                    RowBox[{"-", "L"}], ",", "L"}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"z", ",", 
                    RowBox[{"-", "L"}], ",", "L"}], "}"}], ",", 
                  RowBox[{"AccuracyGoal", "->", "10"}], ",", 
                  RowBox[{"MaxRecursion", "->", "40"}], ",", 
                  RowBox[{"Method", "->", 
                   RowBox[{"{", "\"\<LocalAdaptive\>\"", "}"}]}]}], "]"}], "/",
                 "TotalMass"}], "]"}], ",", "0"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "3"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "3"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "Return", " ", "symmetric", " ", "quadrupole", " ", "tensor"}], 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{"Qc", "+", 
          RowBox[{"Transpose", "[", 
           RowBox[{"UpperTriangularize", "[", 
            RowBox[{"Qc", ",", "1"}], "]"}], "]"}]}]}]}], 
       "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Parallel", " ", "computation", " ", "for", " ", "all", " ", "6", " ", 
       "eigenvectors"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ParallelDo", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"outFile", ",", "localQc"}], "}"}], ",", 
         RowBox[{
          RowBox[{"outFile", "=", 
           RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", 
             RowBox[{"FilePath", ",", 
              RowBox[{"\"\<DimlessQuadrupoleOfEigenvector\>\"", "<>", 
               RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<-\>\"", "<>", 
               "suffix", "<>", "\"\<.m\>\""}]}], "}"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"FileExistsQ", "[", "outFile", "]"}], ",", 
            RowBox[{
             RowBox[{"Print", "[", 
              
              RowBox[{"\"\<Skip eigenvector \>\"", ",", "i", 
               ",", "\"\<: file already exists -> \>\"", ",", "outFile"}], 
              "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"Continue", "[", "]"}], ";"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", 
           
           RowBox[{"\"\<Calculating quadrupole for eigenvector \>\"", ",", 
            "i", ",", "\"\< of 6...\>\""}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"localQc", "=", 
           RowBox[{"MassQuadrupole", "[", 
            RowBox[{"i", ",", 
             RowBox[{"Params", "[", "\"\<R\>\"", "]"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Put", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"localQc", ",", "Params"}], "}"}], ",", "outFile"}], 
           "]"}], ";", "\[IndentingNewLine]", 
