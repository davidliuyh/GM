         "\[IndentingNewLine]", 
         RowBox[{"R", "=", 
          RowBox[{"Params", "[", "\"\<R\>\"", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Rb0", "=", 
          FractionBox["1", 
           RowBox[{"\[Mu]0", " ", "\[Alpha]0"}]]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"Xsys", "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Mc", "*", "Xc"}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"Mc", "+", "M1", "+", "M2"}], ")"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"MXsys", "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Mc", "*", "MXc"}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"Mc", "+", "M1", "+", "M2"}], ")"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"PXsys", "=", 
