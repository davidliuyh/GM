              RowBox[{"[", 
               RowBox[{"4", ",", "4"}], "]"}], "]"}], "+", 
             RowBox[{"\[ImaginaryI]", " ", 
              RowBox[{"GrowthWidth", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"2", ",", "0", ",", "0"}], "}"}], ",", "a2", ",", 
                "M2", ",", "\[Alpha]2"}], "]"}]}]}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"5", ",", "5"}], "}"}], "->", 
            RowBox[{
             RowBox[{"ReducedHamiltonian", "[", 
              RowBox[{"[", 
               RowBox[{"5", ",", "5"}], "]"}], "]"}], "+", 
             RowBox[{"\[ImaginaryI]", " ", 
              RowBox[{"GrowthWidth", "[", 
