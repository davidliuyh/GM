          RowBox[{"3", "/", "2"}]], "*", 
         RowBox[{"DHD\[CapitalOmega]OfEigenvector", "/", "R"}]}]}], ")"}]}]}],
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GetDimlessGWFreqSquare", 
