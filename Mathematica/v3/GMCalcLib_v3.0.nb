   RowBox[{
   "FilePath_", ",", "suffix_", ",", "\[Mu]0_", ",", "\[Alpha]0_", ",", 
    "eigenvectorIndex_", ",", "CurrentDimlessGWFreqSquare_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "Xc", ",", "Params", ",", "R", ",", "\[Alpha]", ",", "M", ",", "q", ",", 
      "qc", ",", "\[Mu]", ",", "Rb1", ",", "Rb0", ",", "\[Rho]1Values", ",", 
      "\[Rho]2Values", ",", "Xsys", ",", "d1", ",", "d2", ",", 
      "CurrentEnergiesInLab"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Xc", ",", "Params"}], "}"}], "=", 
      RowBox[{"Get", "[", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"FilePath", ",", 
          RowBox[{"\"\<DimlessCloudCenterOfMassOfEigenvector\>\"", "<>", 
           RowBox[{"ToString", "[", "eigenvectorIndex", "]"}], 
           "<>", "\"\<-\>\"", "<>", "suffix", "<>", "\"\<.m\>\""}]}], "}"}], 
        "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Alpha]", "=", 
      RowBox[{"Params", "[", "\"\<\[Alpha]1\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"M", "=", 
      RowBox[{
       RowBox[{"Params", "[", "\"\<M1\>\"", "]"}], "*", "Ms"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"q", "=", 
      RowBox[{"Params", "[", "\"\<q\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"qc", "=", 
      RowBox[{"Params", "[", "\"\<qc\>\"", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"R", "=", 
      RowBox[{"Params", "[", "\"\<R\>\"", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Mu]", "=", 
      FractionBox["\[Alpha]", "M"]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Rb1", "=", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"\[Mu]", " ", "\[Alpha]"}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Rb0", "=", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"\[Mu]0", " ", "\[Alpha]0"}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"\[Rho]1Values", "=", 
      RowBox[{
       RowBox[{"q", "/", 
        RowBox[{"(", 
         RowBox[{"1", "+", "q"}], ")"}]}], "*", "R", "*", "Rb0"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"\[Rho]2Values", "=", 
      RowBox[{
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"1", "+", "q"}], ")"}]}], "*", "R", "*", "Rb0"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Xsys", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"qc", "*", "Xc", "*", "Rb1"}], "+", 
          RowBox[{"(", 
           RowBox[{"-", "\[Rho]1Values"}], ")"}], "+", 
          RowBox[{"q", "*", "\[Rho]2Values"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"qc", "+", "1", "+", "q"}], ")"}]}], "/", "Rb0"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{"dimless", ",", " ", 
       RowBox[{"Rb0", " ", "as", " ", "dim"}]}], "*)"}], 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"d1", "=", 
      RowBox[{
       RowBox[{
        FractionBox["q", 
         RowBox[{"1", "+", "q"}]], "*", "R"}], "+", "Xsys"}]}], ";", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"CoM", " ", "to", " ", "BH1"}], ",", " ", "dimless", ",", " ", 
       "Rb0"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"d2", "=", 
      RowBox[{
       RowBox[{
        FractionBox["1", 
         RowBox[{"1", "+", "q"}]], "*", "R"}], "-", "Xsys"}]}], ";", 
     RowBox[{"(*", 
