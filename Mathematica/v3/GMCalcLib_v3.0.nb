           RowBox[{"\"\<Eigenvector \>\"", ",", "i", 
            ",", "\"\< completed.\>\""}], "]"}], ";"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "6"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
