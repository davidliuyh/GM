             RowBox[{"PXsys", "-", "MXsys"}], ")"}], "/", 
            RowBox[{"(", 
             RowBox[{"2", "\[CapitalDelta]R"}], ")"}]}]}]}], ";", 
         RowBox[{"(*", 
          RowBox[{"Dd1", "/", "DR"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"Dd2DR", "=", 
          RowBox[{
           FractionBox["M1", 
            RowBox[{"M1", "+", "M2"}]], "-", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"PXsys", "-", "MXsys"}], ")"}], "/", 
            RowBox[{"(", 
             RowBox[{"2", "\[CapitalDelta]R"}], ")"}]}]}]}], ";", 
         RowBox[{"(*", 
          RowBox[{"Dd2", "/", "DR"}], "*)"}], "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
